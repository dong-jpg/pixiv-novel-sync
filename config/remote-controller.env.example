# VPS controller only. Do not share this file with Web or the cloud worker.
PIXIV_REMOTE_ENABLED=0
PIXIV_REMOTE_STATE_DIR=/var/lib/pixiv-remote
PIXIV_REMOTE_MACHINE_ID=
# Install the scoped provider key in this permission-0600 file, never in source.
# Delete permissions are not needed; this controller uses only this machine ID.
INSTABOX_API_KEY=
