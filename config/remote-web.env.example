# VPS Web process only. Keep disabled until the staged checks in REMOTE_EXECUTION.md.
PIXIV_REMOTE_ENABLED=0
# Business task credentials remain on this VPS. Use a stable random secret >=32 characters.
# Falls back to PIXIV_NOVEL_SYNC_AI_SECRET_KEY if explicitly configured there.
PIXIV_REMOTE_TASK_SECRET=
# Optional routed text calls. The VPS owns provider credentials and budgets.
PIXIV_REMOTE_AI_EXECUTION=local
# Optional HTTPS CONNECT exit. Empty keeps VPS egress and configured AI provider proxy.
# Use https://worker:<independent-url-safe-key>@<trusted-cloud-host>:8443
PIXIV_REMOTE_EGRESS_PROXY=
PIXIV_REMOTE_STATE_DIR=/var/lib/pixiv-remote
PIXIV_REMOTE_MACHINE_ID=
# SHA-256 of the independently generated bootstrap key; no plaintext key here.
# Generate and install credentials in permission-0600 files; see REMOTE_EXECUTION.md.
PIXIV_REMOTE_WORKER_KEY_SHA256=
