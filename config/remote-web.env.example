# VPS Web process only. Keep disabled until the staged checks in REMOTE_EXECUTION.md.
PIXIV_REMOTE_ENABLED=0
PIXIV_REMOTE_STATE_DIR=/var/lib/pixiv-remote
PIXIV_REMOTE_MACHINE_ID=
# SHA-256 of the independently generated bootstrap key; no plaintext key here.
# Generate and install credentials in permission-0600 files; see REMOTE_EXECUTION.md.
PIXIV_REMOTE_WORKER_KEY_SHA256=
