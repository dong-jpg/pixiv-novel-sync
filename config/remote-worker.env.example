# Cloud worker only. Blank credentials make this example unusable until configured.
# Start this distinct service only during an explicitly approved pilot window.
PIXIV_REMOTE_SERVER_ORIGIN=https://library.example.invalid
PIXIV_REMOTE_WORK_DIR=/var/lib/pixiv-remote-worker
# Independent >=256-bit random bootstrap key; install in a permission-0600 file.
# Do not copy the VPS .env, provider key, DB, Flask secret, or account credentials.
PIXIV_REMOTE_WORKER_KEY=
