pixiv:
  timeout: 30
  verify_ssl: true
  proxy: null
  # web_cookie 也可以放这里（建议优先用环境变量 PIXIV_WEB_COOKIE）
  web_cookie: null

sync:
  enabled: false
  initial_manual_only: true
  download_assets: true
  write_markdown: true
  write_raw_text: true
  bookmark_restricts:
    - public
    - private
  max_items_per_run: 20
  # 关注作者作品列表 / 系列章节的单轮翻页上限
  max_pages_per_run: 2
  # 收藏列表专用翻页上限。留空则跟随 max_pages_per_run。
  # 收藏优先级最高，通常要放得比 max_pages_per_run 大得多，否则每轮只看最新
  # 约 30×max_pages_per_run 条收藏就会被标成 truncated，历史收藏补不齐。
  bookmark_max_pages_per_run: 20
  # 单个关注作者每轮最多同步多少篇。留空 = 不限。
  # 建议一定要设：留空时第一个高产作者会把整轮预算吃光，每轮只覆盖 1 个作者。
  following_max_novels_per_author: 20
  # 系列章节分页专用上限。留空则跟随 max_pages_per_run。
  # 跟随时 max_pages_per_run=2 会把长系列的章节列表截断，缺章永远补不齐。
  series_max_pages_per_run: 10
  delay_seconds_between_items: 1.5
  delay_seconds_between_pages: 2.0
  delay_seconds_between_series: 3.0
  delay_seconds_between_chapters: 1.0
  delay_seconds_between_skips: 0.1

  # 同步内容开关
  sync_bookmarks: true
  sync_following_users: true
  sync_following_novels: true
  sync_subscribed_series: true

  # 系列限速
  series_sync_limit: 0  # 0 = 全部

  # ---- 定时任务排布 ----
  # 所有定时任务共用一个 job 槽（BoundedSemaphore(1)，串行），所以这里排的是「预算」
  # 而不只是「频率」：各任务注释里的单轮耗时是生产实测值（3 天 52 轮）。
  # 优先级固定在 web/managers.py:SCHEDULER_TASK_CONFIGS：收藏 P1、追更系列 P2、其余 P3；
  # 同级按逾期最久优先，可让位任务会给更高优先级腾槽。详见 docs/JOB_SYSTEM.md §3.6。
  # 排布原则：P1 收藏每天 6 次均匀铺开（任何时刻最多等 4 小时）；长任务避开收藏时刻
  # ±30 分钟，减少无谓让位；时效性弱的任务拉到隔日或隔三日。
  #
  # 全局开关。仅在 dashboard "启用自动同步" 按钮按下时开启
  auto_sync_enabled: false
  # 时区，决定 cron 表达式的解释。如 Asia/Seoul / Asia/Shanghai / UTC
  auto_sync_timezone: Asia/Seoul

  # 各任务开关 / interval / cron。cron 优先于 interval；cron 留空时使用 interval。
  # cron 解析失败是**静默**回落到 interval，所以改完务必用 settings.cron_to_next_run
  # 逐条验算下次运行时刻。cron 值一律加引号：以 "*" 开头的裸标量会被 YAML 当成别名报错。

  # P1 收藏：时效性最高，每天 6 次（单轮约 3 分钟）
  auto_sync_bookmarks_enabled: true
  auto_sync_bookmarks_interval_hours: 4
  auto_sync_bookmarks_cron: "20 0,4,8,12,16,20 * * *"

  # P2 追更系列：单轮约 13 分钟。实测连续 12 轮零新增，从 4 次/天降到 2 次
  auto_sync_subscribed_series_enabled: true
  auto_sync_subscribed_series_interval_hours: 12
  auto_sync_subscribed_series_cron: "40 1,13 * * *"

  # 关注用户列表：following_novels 的输入，单轮约 5 分钟
  auto_sync_following_list_enabled: true
  auto_sync_following_list_interval_hours: 24
  auto_sync_following_list_cron: "30 10 * * *"

  # 关注用户小说：最大预算项。每轮只跑 users_limit 个作者，按 user_last_synced 轮转，
  # 配合 following_max_novels_per_author 后单轮从 42 分钟降到约 24 分钟，
  # 同频率下覆盖率提升 5 倍，所以频率保持每天 4 次不动
  auto_sync_following_novels_enabled: true
  auto_sync_following_novels_interval_hours: 6
  auto_sync_following_novels_cron: "0 3,9,15,21 * * *"
  # 每轮扫描几个关注用户。0 = 不限制。
  # 注意 user_backup 复用同一个值（jobs/quick_sync.py），改动会同时影响两个任务
  auto_sync_following_novels_users_limit: 5

  # 小说状态巡检：预算第二大但时效性最弱，从 4 次/天降到 2 次（全库轮转周期 2.4→4.8 天）。
  # 用户主动取消收藏/追更由 pending_deletion_detection 每天检测，不受这里降频影响
  auto_sync_novel_status_enabled: true
  auto_sync_novel_status_interval_hours: 12
  auto_sync_novel_status_cron: "0 5,17 * * *"

  # 用户/系列状态巡检：各自每轮都能跑完全库，隔日足够
  auto_sync_user_status_enabled: true
  auto_sync_user_status_interval_hours: 48
  auto_sync_user_status_cron: "30 6 */2 * *"
  auto_sync_series_status_enabled: true
  auto_sync_series_status_interval_hours: 48
  auto_sync_series_status_cron: "30 18 */2 * *"

  # 全量备份关注用户小说：兜底，最弱时效，默认关闭
  auto_sync_user_backup_enabled: false
  auto_sync_user_backup_interval_hours: 72
  auto_sync_user_backup_cron: "30 2 */3 * *"

  # 检测取消收藏/追更：单轮约 34 秒，每天一次
  auto_sync_pending_detection_enabled: true
  auto_sync_pending_detection_interval_hours: 24
  auto_sync_pending_detection_cron: "30 12 * * *"

  # 增量偏好分析：纯本地计算不耗 Pixiv 配额，但同样占用那个唯一的 job 槽，
  # 所以也要排在收藏时刻之外，每天两次足够
  auto_sync_preference_analyze_enabled: false
  auto_sync_preference_analyze_interval_hours: 12
  auto_sync_preference_analyze_cron: "15 7,19 * * *"
  preference_analyze_batch_size: 200

  # 定时生成推荐：一轮最多 20 条 Pixiv 检索，是唯一额外吃搜索配额的任务，每天一次；
  # 且必须先有默认偏好画像，否则任务直接失败。默认关闭
  auto_sync_recommendation_run_enabled: false
  auto_sync_recommendation_run_interval_hours: 24
  auto_sync_recommendation_run_cron: "50 8 * * *"

  # pending_deletions 清理策略
  pending_deletion_grace_period_days: 30
  pending_deletion_cleanup_confirmed_days: 7

  # 任务日志（task_logs + ai_jobs）保留天数。调度器每小时清理一次。
  # 原来硬编码 3 天，导致耗时趋势和调度预算最多只能回看 3 天。
  task_log_retention_days: 14

storage:
  public_dir: ./data/library/public
  private_dir: ./data/library/private
  db_path: ./data/state/pixiv_sync.db
