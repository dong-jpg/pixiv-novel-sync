# Install only on the trusted cloud host. HTTPS is mandatory; restrict ingress to VPS IP.
PIXIV_REMOTE_EGRESS_LISTEN=127.0.0.1
PIXIV_REMOTE_EGRESS_PORT=8443
PIXIV_REMOTE_EGRESS_CERT=/etc/pixiv-remote/egress-fullchain.pem
PIXIV_REMOTE_EGRESS_PRIVATE_KEY=/etc/pixiv-remote/egress-key.pem
# Independent random key, >=32 URL-safe characters. No Pixiv or model credentials.
PIXIV_REMOTE_EGRESS_KEY=
# Explicit allowlist. Add only the actual provider hostnames configured on the VPS.
PIXIV_REMOTE_EGRESS_HOSTS=app-api.pixiv.net,www.pixiv.net
