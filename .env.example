# Pixiv 凭据 - 同步必须有 PIXIV_REFRESH_TOKEN（可在 /token-login 页获取）。
# PIXIV_USERNAME / PIXIV_PASSWORD 只供 /token-login 的「自动登录」与 Web Cookie 自动刷新使用（需要 Playwright），不能代替 refresh token。
PIXIV_REFRESH_TOKEN=
PIXIV_ACCESS_TOKEN=
PIXIV_USER_ID=
PIXIV_USERNAME=
PIXIV_PASSWORD=

# 网络
PIXIV_PROXY=
PIXIV_TIMEOUT=30
PIXIV_VERIFY_SSL=true

# Web Cookie 用于读取追更系列列表（Pixiv 网页版登录后从浏览器复制）
PIXIV_WEB_COOKIE=

# 存储路径
PIXIV_PUBLIC_DIR=./data/library/public
PIXIV_PRIVATE_DIR=./data/library/private
PIXIV_DB_PATH=./data/state/pixiv_sync.db
PIXIV_LOG_LEVEL=INFO

# Dashboard 访问密码（公网/反代部署必须配置；留空时仅允许本机访问）
DASHBOARD_TOKEN=

# 是否信任反向代理注入的 X-Forwarded-For（仅在确实部署于可信反代之后才开启）。
# 部署在本机 Nginx 之后却不开启时，所有请求的来源地址都是 127.0.0.1：登录失败限流与救援 API 限流
# 会变成全站共用一个桶，任何人输错 5 次密码即可让你暂时登不上。
DASHBOARD_TRUST_PROXY=false
# 可信反代层数：真实客户端 IP 位于 X-Forwarded-For 右数第 N 个条目，默认 1（单层 nginx）。
# 用于抵御伪造 XFF 绕过登录限流 / 本机判定。
DASHBOARD_TRUSTED_PROXY_HOPS=1

# Flask session 密钥（缺省时服务会生成随机值并写回 .env；生产建议手动固定）
PIXIV_FLASK_SECRET=

# 经 HTTPS 访问（含 Cloudflare / 反代）时设为 true，让 session cookie 仅经 HTTPS 传输。
# 留空时只在 DASHBOARD_TRUST_PROXY 为真时自动开启，不会检测请求头；设为 false 强制关闭（仅纯 HTTP 本机调试用）。
PIXIV_COOKIE_SECURE=

# 历史遗留：OAuth 的 redirect_uri 现已固定为 Pixiv 注册的地址，本项不再影响登录流程，可留空。
PIXIV_EXTERNAL_BASE_URL=

# Nginx 图片缓存目录（系统设置页的缓存统计与清理用），默认 /var/cache/nginx/pixiv_img
PIXIV_NGINX_CACHE_DIR=

# AI Provider API key 加密密钥（保存 Provider API key 前必须配置，并保持稳定）
PIXIV_NOVEL_SYNC_AI_SECRET_KEY=

# AI Provider base_url 安全校验：默认拒绝指向本机/内网/云元数据地址（防 SSRF/密钥外泄）。
# 如需访问本机或内网自建模型服务，设为 1 放行私有/回环地址（仍禁止 link-local 元数据）。
PIXIV_AI_ALLOW_PRIVATE_HOSTS=
