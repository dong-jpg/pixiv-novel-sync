[Unit]
Description=Pixiv remote TLS egress
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pixivremote
Group=pixivremote
EnvironmentFile=/etc/pixiv-remote/egress.env
ExecStart=/opt/pixiv-novel-sync/app/.venv/bin/pixiv-remote egress
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077

[Install]
WantedBy=multi-user.target
