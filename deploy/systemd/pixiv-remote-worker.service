[Unit]
Description=Pixiv remote worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pixivremote
WorkingDirectory=/opt/pixiv-novel-sync/app
EnvironmentFile=/etc/pixiv-remote/worker.env
ExecStart=/opt/pixiv-novel-sync/app/.venv/bin/pixiv-remote worker
Restart=always
RestartSec=15
KillMode=control-group
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
